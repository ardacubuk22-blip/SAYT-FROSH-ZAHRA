# Copy this file to .env and fill in the values. .env is never committed to git.
ANTHROPIC_API_KEY=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
EXTRACTION_MODEL=claude-haiku-5-5
MONTHLY_API_BUDGET_USD=10
REVIEW_CONFIDENCE_THRESHOLD=0.75
CRAWLER_DELAY_SECONDS=3
WHATSAPP_NUMBER=PHONE_NUMBER

